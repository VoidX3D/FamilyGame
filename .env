# Settings for the Family Game API.
#
# This file is read by the server itself, so it works no matter how the
# process is started ("npm start", "npm run dev" or "node index.js" on the
# hosting panel). A real environment variable always wins over this file.

# The port the API listens on. The hosting panel sets its own value, which
# takes priority.
PORT=12800

# The frontends that may talk to this server. The deployed site is
# https://funfamilygame.vercel.app and is already included by default.
# A pattern such as https://*.vercel.app covers a domain change.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://funfamilygame.vercel.app

# The address the service is reached on in the wild. The API documentation
# says it, so it belongs here rather than in the code.
PUBLIC_URL=https://familygame.wisp.uno

# The passcode for the host console. This one is used as it is.
ADMIN_PASSCODE=familygameadmin

# Sign-in attempts allowed per address in ten minutes.
ADMIN_LOGIN_ATTEMPTS=10

# How many proxies sit in front of the API. 1 is correct for the hosting
# panel. Use false if the API is exposed directly.
TRUST_PROXY=1

# Where the edited game content is stored. Use :memory: to keep it in
# memory only.
# CONTENT_FILE=:memory:

# If ADMIN_PASSCODE is ever removed, the server makes a strong one, keeps it
# in data/admin-passcode and prints it on startup.

# Local development
#
# Copy this file to .env and change what you need. The defaults already work
# for a local install: the API on port 12800, the preview on port 5173, and
# the deployed frontend on https://funfamilygame.vercel.app.
PORT=12800
NODE_ENV=development

# The frontends that may talk to this server.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://funfamilygame.vercel.app

# The address the service is reached on in the wild. The API documentation
# says it, so it belongs here rather than in the code.
# PUBLIC_URL=https://familygame.wisp.uno

# Sign-in attempts allowed per address in ten minutes.
# ADMIN_LOGIN_ATTEMPTS=10

# How many proxies sit in front of the API.
# TRUST_PROXY=1

# Where the edited game content is stored. Use :memory: to keep it in
# memory only.
# CONTENT_FILE=:memory:

# The passcode for the host console. Leave it empty and the server makes a
# strong one, keeps it in data/admin-passcode and prints it on startup.
# ADMIN_PASSCODE=

# Wispbyte production (set these in the panel, not in this file)
# PORT=12800
# NODE_ENV=production
# ADMIN_PASSCODE=<strong passcode>
# FRONTEND_ORIGINS=https://funfamilygame.vercel.app
# PUBLIC_URL=https://familygame.wisp.uno
